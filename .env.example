# Скопируй в .env: cp .env.example .env
# Секреты здесь не храним — только пути к файлам в secrets/ (их создаёт `make secrets`).

# --- Telegram ---
TELEGRAM_TOKEN_FILE=./secrets/telegram_token
# Твой Telegram ID (суперадмин). Узнать: запусти бота и отправь ему /whoami.
SUPERADMIN_TG_ID=
# Тестовый режим: все уведомления по расписанию уходят только этим людям в личку, каждому
# своя копия (с пометкой 🧪), команде — ничего. Можно несколько ID через запятую.
# Пусто — режим выключен. Каждый должен был написать боту /start.
TEST_RECIPIENT_TG_ID=

# --- База ---
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=remindbot
DATABASE_USER=bot

# --- YouGile ---
# Ключ API: по задачам доски «ПУБЛИКАЦИИ ВСЕГО» бот напоминает о публикациях.
# Пусто — напоминаний из YouGile нет. Бот только читает задачи, в YouGile ничего не пишет.
YOUGILE_API_KEY_FILE=./secrets/yougile_api_key

# --- Сценарии ---
# Ссылка на отчёт продажников в Яндекс Документах (https://…). Если задана, в напоминании
# «пора заполнить отчёт» будет кнопка «📄 Открыть отчёт». Пусто — без кнопки.
SALES_REPORT_URL=

# Работают всегда: напоминания о публикации (за 30 мин), просьба прислать материал
# за сутки (+1 напоминание через час), контент-план в пн 13:00, отчёт продажников
# в пн/ср/пт 16:00. Ниже — то, что выключено, пока не задано true.
# Вечерний опрос продажников «отправил?» с кнопками и итогом дня админам.
FEATURE_SALES_POLL=false
# «Выложено?» [Да] [Нет] через 30 мин после публикации, до 4 раз.
FEATURE_PUBLISH_QUESTIONS=false

# --- Прочее ---
BOT_TIMEZONE=Europe/Moscow
HEALTH_ADDR=127.0.0.1:8081
LOG_LEVEL=info
# Копия логов в файл (дописывается). Пусто — только в консоль. Секреты в логи не попадают.
LOG_FILE=./logs/remindbot.log
