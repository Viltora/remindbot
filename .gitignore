# ============================================================
# Секреты — НИКОГДА не коммитить
# ============================================================

# Настройки окружения (в .env — Telegram ID людей и пути к секретам).
# Шаблон .env.example коммитим, он без значений.
.env
.env.*
*.env
!.env.example

# Локальные данные: адрес сервера, реальные ID/ники/имена
deploy.local.mk
PRIVATE.md
*.local.*
!*.local.*.example
!deploy.local.mk.example

# Токен бота, ключ YouGile, пароль базы (создаёт `make secrets`)
secrets/
/run/secrets/

# Ключи, сертификаты, доступы к серверу
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
*.kdbx
.netrc
.pgpass

# Любые файлы, в имени которых явно секрет
*secret*
*token*
*password*
*apikey*
*api_key*
!internal/**/*.go
!cmd/**/*.go

# ============================================================
# Данные и артефакты
# ============================================================

# Дампы базы (в них персональные данные пользователей бота)
backups/
*.sql.gz
*.dump

# Логи
logs/
*.log

# Сборка
bin/
*.test
*.out
coverage.*

# ============================================================
# Окружение разработчика
# ============================================================
.DS_Store
.idea/
.vscode/
*.swp
*~
